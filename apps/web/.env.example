DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pushstack
R2_ENDPOINT=

RESEND_API_KEY=
RESEND_EMAIL_FROM=

# Optional tuning knobs (defaults in src/server/config.ts).
# GIT_HTTP_MAX_BODY_BYTES=52428800   # git endpoint request body cap, default 50MB
# GIT_CACHE_MAX_SIZE=1073741824      # git object cache budget, default 1GB
# GIT_CACHE_TTL=3600                 # immutable cache entry TTL in seconds, default 1h
# PUSHSTACK_PERF_LOG=1               # print the per-request timing tree in production

# Sentry (error tracking) — safe to leave unset; the SDK no-ops without a DSN.
VITE_SENTRY_DSN=
# Only needed to upload source maps at build time (CI/release builds).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

{
	"Repository": [
		{
			"name": "issue",
			"args": ["number"]
		},
		{
			"name": "issueOrPullRequest",
			"args": ["number"]
		},
		{
			"name": "issues",
			"args": [
				"after",
				"before",
				"first",
				"last",
				"labels",
				"orderBy",
				"states",
				"filterBy"
			]
		}
	],
	"Issue": {
		"$implements": ["Node", "UniformResourceLocatable"],
		"fields": [
			"id",
			"databaseId",
			"number",
			"title",
			"body",
			"state",
			"stateReason",
			"url",
			"resourcePath",
			"createdAt",
			"updatedAt",
			"closedAt",
			"closed",
			"author",
			"repository",
			"milestone",

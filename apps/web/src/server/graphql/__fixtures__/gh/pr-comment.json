{
	"gh": "gh version 2.104.0 (2026-11-12)",
	"command": "gh pr comment 1 -R HOST/octo/hello --body Hi",
	"requests": [
		{
			"query": "\n\tquery PullRequestByNumber($owner: String!, $repo: String!, $pr_number: Int!) {\n\t\trepository(owner: $owner, name: $repo) {\n\t\t\tpullRequest(number: $pr_number) {id,url,number}\n\t\t}\n\t}",
			"variables": {
				"owner": "octo",
				"pr_number": 1,
				"repo": "hello"
			}
		},
		{
			"query": "mutation CommentCreate($input:AddCommentInput!){addComment(input: $input){commentEdge{node{url}}}}",
			"variables": {
				"input": {
					"subjectId": "MDExOlB1bGxSZXF1ZXN0MQ==",
					"body": "Hi"
				}
			}
		}
	]
}

{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "turbo run build --filter=@pushstack/web",
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": true
		}
	},
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow, noarchive, noimageai, noai"
				}
			]
		},
		{
			"source": "/robots.txt",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, s-maxage=86400"
				}
			]
		}
	]
}

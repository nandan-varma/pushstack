{
	"name": "@pstk/cli",
	"version": "0.0.1",
	"description": "The PushStack command line: a gh-compatible CLI over the /api/v3 REST API.",
	"license": "AGPL-3.0-or-later",
	"author": "Nandan Varma",
	"keywords": [
		"pushstack",
		"cli",
		"git",
		"github-compatible"
	],
	"type": "module",
	"bin": {
		"pushstack": "./dist/bin.js",
		"pst": "./dist/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
		"lint": "biome check ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nandan-varma/pushstack.git",
		"directory": "apps/cli"
	},
	"homepage": "https://docs.git.nandan.fyi/docs/cli",
	"bugs": {
		"url": "https://github.com/nandan-varma/pushstack/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@pushstack/api-contract": "workspace:*",
		"@pushstack/tsconfig": "workspace:*",
		"@types/node": "^26.6.6",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}

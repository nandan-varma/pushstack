{
	"name": "git-edge",
	"version": "0.6.2",
	"description": "High-level edge-compatible git operations \u2014 parsed-object cache, object-level three-way merge, and repo management utilities. Composes with git-fs-s3.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
		"lint": "biome check ."
	},
	"keywords": [
		"git",
		"isomorphic-git",
		"edge",
		"serverless",
		"merge",
		"cache",
		"three-way-merge"
	],
	"author": "Nandan Varma",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nandan-varma/pushstack.git",
		"directory": "packages/git-edge"
	},
	"bugs": {
		"url": "https://github.com/nandan-varma/pushstack/issues"
	},
	"homepage": "https://docs.git.nandan.fyi/docs/libraries/git-edge",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"lru-cache": "^11.5.3",
		"node-diff3": "^3.2.1"
	},
	"peerDependencies": {
		"git-fs-s3": ">=0.19.0",
		"isomorphic-git": ">=1.44.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"diff": "^9.0.0",
		"git-fs-s3": "workspace:*",
		"isomorphic-git": "^1.44.3",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"@pushstack/tsconfig": "workspace:*"
	}
}

  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "shadcn": "^4.22.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "neverBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ],
    "overrides": {
      "esbuild": ">=0.28.1 <0.29.0",
      "hono": ">=4.12.34 <5.0.0",
      "@hono/node-server": ">=1.19.15 <2.0.0",
      "undici": ">=7.29.0 <8.0.0",
      "effect": ">=3.20.0 <4.0.0",
      "lodash": ">=4.18.0 <5.0.0",

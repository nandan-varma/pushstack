    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "git-edge": "^0.6.0",
    "git-fs-s3": "^0.14.0",
    "isomorphic-git": "^1.44.3",
    "lucide-react": "^1.59.0",
    "mdast-util-find-and-replace": "^3.0.3",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"

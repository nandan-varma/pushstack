{
	"name": "pushstack-monorepo",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "turbo run dev --filter=@pushstack/web",
		"dev:local": "pnpm --filter @pushstack/web dev:local",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"smoke:git": "turbo run smoke:git",
		"check": "biome check",
		"format": "biome format --write",
		"db:push": "pnpm --filter @pushstack/web db:push",
		"db:studio": "pnpm --filter @pushstack/web db:studio",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.9"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"packageManager": "pnpm@9.15.5",
	"pnpm": {
		"neverBuiltDependencies": [
			"@prisma/engines",
			"prisma"
		],
		"overrides": {
			"esbuild": ">=0.28.1 <0.29.0",
			"hono": ">=4.12.34 <5.0.0",
			"@hono/node-server": ">=1.19.15 <2.0.0",
			"undici": ">=7.29.0 <8.0.0",
			"effect": ">=3.20.0 <4.0.0",
			"lodash": ">=4.18.0 <5.0.0",
			"ws": ">=8.21.0 <9.0.0",
			"sharp": ">=0.35.0 <1.0.0",
			"valibot": ">=1.4.2 <2.0.0",
			"deepmerge-ts": ">=8.0.0 <9.0.0",
			"mysql2": ">=3.23.1 <4.0.0",
			"fast-uri": ">=3.1.8 <4.0.0",
			"ip-address": ">=10.7.1 <11.0.0",
			"brace-expansion@>=4": ">=5.0.12 <6.0.0",
			"seroval": ">=1.6.3 <2.0.0",
			"seroval-plugins": ">=1.6.3 <2.0.0",
			"source-map-js": ">=1.2.2 <2.0.0",
			"proxy-addr": ">=2.0.8 <3.0.0",
			"@modelcontextprotocol/sdk": ">=1.31.0 <2.0.0",
			"shell-quote": ">=1.11.0 <2.0.0",
			"postcss-selector-parser@<7.1.6": ">=7.1.6 <8.0.0"
		},
		"auditConfig": {
			"ignoreGhsas": [
				"GHSA-vfj7-8cjw-p6xm"
			]
		}
	}
}

{
	"name": "pushstack-monorepo",
	"private": true,
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "turbo run dev --filter=@pushstack/web",
		"dev:local": "pnpm --filter @pushstack/web dev:local",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"smoke:git": "turbo run smoke:git",
		"check": "biome check",
		"format": "biome format --write",
		"db:push": "pnpm --filter @pushstack/web db:push",
		"db:studio": "pnpm --filter @pushstack/web db:studio",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.11.9"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"packageManager": "pnpm@12.14.0"
}

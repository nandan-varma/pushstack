      "mysql2": ">=3.23.1 <4.0.0",
      "fast-uri": ">=3.1.8 <4.0.0",
      "ip-address": ">=10.7.1 <11.0.0",
      "brace-expansion@>=4": ">=5.0.12 <6.0.0",
      "seroval": ">=1.6.3 <2.0.0",
      "seroval-plugins": ">=1.6.3 <2.0.0",
      "source-map-js": ">=1.2.2 <2.0.0",
      "proxy-addr": ">=2.0.8 <3.0.0",
      "@modelcontextprotocol/sdk": ">=1.31.0 <2.0.0",
      "shell-quote": ">=1.11.0 <2.0.0",
      "postcss-selector-parser@<7.1.6": ">=7.1.6 <8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
